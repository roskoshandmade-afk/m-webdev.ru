# VITE_TELEGRAM_USERNAME: Ваш логин в Telegram без символа @ (например, m_web).
VITE_TELEGRAM_USERNAME=YOUR_USERNAME

# VITE_MAX_PROFILE_URL: Ссылка на ваш чат или профиль в мессенджере MAX (например, https://max.ru/...).
VITE_MAX_PROFILE_URL=https://max.ru/YOUR_MAX_USERNAME

# VITE_AVITO_PROFILE_URL: Ссылка на ваш профиль или магазин на Авито.
VITE_AVITO_PROFILE_URL=https://www.avito.ru/brands/YOUR_AVITO_ID

# VITE_LEAD_WEBHOOK_URL: Необязательный HTTPS URL прокси-вебхука для тихой фоновой доставки заявок.
VITE_LEAD_WEBHOOK_URL=
