# VITE_TELEGRAM_USERNAME: Ваш логин в Telegram без символа @ (например, tavrika_web).
# Используется для прямой кнопки "Отправить в Telegram" (https://t.me/<username>?text=...).
VITE_TELEGRAM_USERNAME=YOUR_USERNAME

# VITE_LEAD_WEBHOOK_URL: Необязательный HTTPS URL прокси-вебхука (например, Cloudflare Worker / n8n / Make)
# для тихой фоновой доставки заявок на статическом хостинге (GitHub Pages).
VITE_LEAD_WEBHOOK_URL=
